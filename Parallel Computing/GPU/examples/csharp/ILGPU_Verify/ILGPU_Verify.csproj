<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ClassroomVersion>2.0.0-classroom.b6439a32.3</ClassroomVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs;Kernel.cs" />
    <PackageReference Include="ILGPU" Version="$(ClassroomVersion)" />
    <PackageReference Include="ILGPUC" Version="$(ClassroomVersion)"
                      GeneratePathProperty="true" ExcludeAssets="build;buildTransitive" />
  </ItemGroup>
  <Import Project="tooling/CompileKernels.targets" />
</Project>
